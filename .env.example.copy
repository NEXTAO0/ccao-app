# CCAO environment template. Replace placeholders locally; never commit real secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_AUTH_COOKIE_NAME=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID
GCP_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GCP_PRIVATE_KEY=your-gcp-private-key-with-literal-escaped-newlines
GCP_BILLING_ACCOUNT_ID=billingAccounts/000000-000000-000000
GCP_BIGQUERY_TABLE=your-billing-project.billing_export.gcp_billing_export_v1_000000
GCP_BIGQUERY_PROJECT=your-billing-project
GCP_BIGQUERY_LOCATION=US

AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_IAM_USERNAME=your-aws-iam-username

OPENAI_ADMIN_KEY=your-openai-admin-key
OPENAI_API_KEY_ID=your-openai-api-key-id

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Alerts <alerts@yourdomain.com>
EMAIL_TO=you@yourdomain.com
EMAIL_PROVIDER=resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your_gmail_app_password

CRON_SECRET=replace-with-a-long-random-string
CRYPTO_SECRET=replace-with-a-32-byte-base64-secret
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS=
# Paddle Billing SaaS (closed-source, merchant of record). Never commit real keys.
# Use a sandbox account for local dev/CI (test_ client token) and live for production.
PADDLE_API_KEY=pdl_sandbox_your_api_key
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_your_notification_secret
PADDLE_PRICE_MONTHLY=pri_your_monthly_price_id
PADDLE_PRICE_ANNUAL=pri_your_annual_price_id
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_client_side_token
NEXT_PUBLIC_PADDLE_ENV=sandbox
